{
    "BasedColors": {
        "svg": "#a3a3b9",
        "border": "1px solid #a3a3b9",
        "text": "#ffffff",
        "text_edit": "#ffffff"
    },
    "QWidget": {
        "background-color": "qlineargradient(x1:0.50, y1:1.00, x2:0.50, y2:0.00, stop:0 #222329, stop:1 #24252c)",
        "color": "#ffffff",
        "font-size": "14px"
    },
    "QPushButton": {
        "background-color": "#7b7b8b",
        "color": "#ffffff",
        "height": "30px",
        "border": "none",
        "border-radius": "0px",
        "font-size": "14px"
    },
    "QPushButton:hover": {
        "background-color": "#70707e",
        "color": "#ffffff",
        "font-size": "14px"
    },
    "QPushButton:pressed": {
        "background-color": "rgba(95, 95, 107, 1.0)",
        "padding-left": "3px",
        "padding-top": "3px"
    },
    "QTabBar": {
        "background-color": "transparent"
    },
    "QTabBar::tab": {
        "background-color": "rgba(65, 65, 74, 1.0)",
        "color": "#ffffff",
        "height": "30px",
        "border": "none",
        "border-radius": "5px",
        "font-size": "13px",
        "margin": "0",
        "padding": "3px",
        "padding-left": "8px",
        "padding-right": "8px"
    },
    "QTabBar::tab:selected": {
        "background-color": "rgba(96, 96, 109, 1.0)",
        "color": "#ffffff",
        "font-size": "13px",
        "margin-left": "-4px"
    },
    "QTabBar::pane": {
        "background": "transparent",
        "border-bottom": "1px solid #a3a3b9"
    },
    "QLineEdit": {
        "background-color": "transparent",
        "border": "1px solid #a3a3b9",
        "border-radius": "0px",
        "padding": "5px"
    },
    "QComboBox": {
        "background-color": "transparent",
        "border": "1px solid #a3a3b9",
        "border-radius": "0px",
        "padding": "5px"
    },
    "QCheckBox": {
        "background-color": "transparent",
        "padding": "2px"
    },
    "QCheckBox::indicator": {
        "width": "12px",
        "height": "12px",
        "border": "1px solid #a3a3b9",
        "border-radius": "5px",
        "padding": "5px"
    },
    "QCheckBox::indicator:hover": {
        "width": "11px",
        "height": "11px"
    },
    "QCheckBox::indicator:checked": {
        "background-color": "#a3a3b9"
    },
    "QTextEdit": {
        "background": "transparent",
        "color": "#ffffff",
        "border": "none",
        "font-size": "15px"
    },
    "QMainWindow": {
        "background-color": "transparent"
    },
    "QMenu": {
        "background-color": "rgba(65, 65, 74, 0.59)",
        "color": "#ffffff",
        "border-radius": "10px",
        "font-size": "13px",
        "padding": "5px",
        "border": "none",
        "margin": "0px"
    },
    "QMenu::item": {
        "background-color": "#7b7b8b",
        "padding": "10px 30px",
        "margin": "1px",
        "border-radius": "5px"
    },
    "QMenu::item:selected": {
        "background-color": "#70707e",
        "border-left": "2px solid #a3a3b9"
    },
    "QColorDialog QPushButton": {
        "padding-left": "5px",
        "padding-right": "5px"
    },
    "QSlider::handle:horizontal": {
        "background-color": "#7b7b8b",
        "border": "1px solid #a3a3b9",
        "border-radius": "3px",
        "width": "12px",
        "height": "18px",
        "margin": "-7px 0"
    },
    "QSlider::groove:horizontal": {
        "background": "1px solid #a3a3b9",
        "height": "8px",
        "border-radius": "4px",
        "margin": "0"
    },
    "QScrollBar:vertical": {
        "border": "none",
        "background": "rgba(93, 93, 106, 1.0)",
        "width": "8px",
        "border-radius": "4px",
        "margin": "0px"
    },
    "QScrollBar::handle:vertical": {
        "background": "1px solid #a3a3b9",
        "border-radius": "4px",
        "min-height": "20px",
        "margin": "0px"
    },
    "QScrollBar::add-line:vertical": {
        "border": "none",
        "background": "none",
        "height": "0px",
        "width": "0px"
    },
    "QScrollBar::sub-line:vertical": {
        "border": "none",
        "background": "none",
        "height": "0px",
        "width": "0px"
    },
    "QScrollBar::add-page:vertical": {
        "background": "none"
    },
    "QScrollBar::sub-page:vertical": {
        "background": "none"
    },
    "QListWidget": {
        "border": "1px solid #a3a3b9",
        "border-radius": "0px"
    },
    "QListWidget::item": {
        "background-color": "rgba(65, 65, 74, 1.0)",
        "border": "none",
        "padding": "0px",
        "margin": "0px",
        "outline": "none"
    },
    "QListWidget::item:alternate": {
        "background": "transparent"
    },
    "QListWidget::item:selected": {
        "background": "rgba(109, 109, 123, 1.0)",
        "border": "none",
        "outline": "none"
    },
    "QSpinBox": {
        "background-color": "transparent",
