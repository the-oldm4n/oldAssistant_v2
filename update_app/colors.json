        "border-radius": "5px",
        "margin-top": "1.0em"
    },
    "QGroupBox::title": {
        "background-color": "transparent",
        "subcontrol-position": "top left",
        "subcontrol-origin": "margin",
        "padding": "0 10px 0 10px",
        "margin-top": "-0.5em"
    },
    "TitleBar": {
        "background": "transparent",
        "border-bottom": "1px solid #a3a3b9",
