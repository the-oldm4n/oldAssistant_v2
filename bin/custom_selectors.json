{
    "LogArea": {
        "background": "transparent"
    },
    "CustomPage": {
        "background-color": "transparent"
    },
    "CustomPageWidget": {
        "background-color": "get_pressed_css(for_type='border', darken=250, alpha=150)",
        "border-radius": "get_border_radius_css('main')"
    },
    "CustomPageContent": {
        "background-color": "transparent"
    },
    "TabPanel": {
        "background": "transparent"
    },
    "TabBtn": {
        "background": "get_pressed_css(for_type='border', darken=200)",
        "border": "none",
        "border-radius": "0px"
    },
    "TabBtn:hover": {
        "background": "get_pressed_css(for_type='border', darken=160)"
    },
    "TabBtn[active='true']": {
        "background": "get_pressed_css(for_type='svg', darken=100)",
        "border": "get_css('border')"
    },
    "SlidingStackedWidget": {
        "background-color": "transparent"
    },
    "QStackedWidget": {
        "background-color": "transparent"
    },
    "StatsWidget": {
        "background-color": "transparent"
    },
    "ToolPanelTitle": {
        "background-color": "transparent",
        "border-bottom": "get_css('border')"
    },
    "AudioPlayerWidget": {
        "background-color": "transparent",
        "border-top": "get_css('border')"
    },
    "ToolPanel": {
        "background-color": "get_pressed_css(for_type='svg', darken=800, alpha=220)",
        "border-radius": "10px"
    },
    "ToolPanelBtn": {
        "background-color": "transparent",
        "border": "none",
        "border-radius": "5px"
    },
    "ToolPanelBtn:hover": {
        "background": "get_pressed_css(for_type='svg', darken=100, alpha=200)"
    },
    "ToolPanelTab": {
        "background": "rgba(50, 50, 50, 150)",
        "color": "white",
        "border": "none",
        "border-radius": "5px",
        "padding": "5px",
        "font-size": "15px"
    },
    "ToolPanelTab:hover": {
        "background": "rgba(70, 70, 70, 200)"
    },
    "ToolPanelTab:pressed": {
        "background": "rgba(40, 110, 230, 200)"
    }
}